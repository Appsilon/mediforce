{
  "processName": "protocol-to-tfl",
  "configName": "opencode-extract",
  "configVersion": "8",
  "env": {
    "DEEPSEEK_API_KEY": "{{DEEPSEEK_API_KEY}}",
    "OPENROUTER_API_KEY": "{{OPENROUTER_API_KEY}}"
  },
  "stepConfigs": [
    {
      "stepId": "upload-documents",
      "executorType": "human"
    },
    {
      "stepId": "extract-metadata",
      "executorType": "agent",
      "plugin": "opencode-agent",
      "autonomyLevel": "L3",
      "timeoutMinutes": 20,
      "agentConfig": {
        "image": "mediforce-agent:protocol-to-tfl",
        "model": "deepseek/deepseek-chat",
        "prompt": "Use the `trial-metadata-extractor` skill: it holds this step's instructions. Load it first and follow it."
      }
    },
    {
      "stepId": "generate-tlg-shells",
      "executorType": "agent",
      "plugin": "opencode-agent",
      "autonomyLevel": "L3",
      "timeoutMinutes": 45,
      "agentConfig": {
        "image": "mediforce-agent:protocol-to-tfl",
        "model": "deepseek/deepseek-chat",
        "prompt": "Use the `mock-tlg-generator` skill: it holds this step's instructions. Load it first and follow it."
      }
    },
    {
      "stepId": "upload-sdtm",
      "executorType": "human"
    },
    {
      "stepId": "generate-adam",
      "executorType": "agent",
      "plugin": "opencode-agent",
      "autonomyLevel": "L3",
      "timeoutMinutes": 30,
      "agentConfig": {
        "image": "mediforce-agent:protocol-to-tfl",
        "model": "deepseek/deepseek-chat",
        "repo": "Appsilon/mediforce-clinical-workspace",
        "commit": "4beb1b0ad77872b04bc7ef930def16e555946222",
        "prompt": "Use the `sdtm-to-adam` skill: it holds this step's instructions. Load it first and follow it."
      }
    },
    {
      "stepId": "generate-tlg",
      "executorType": "agent",
      "plugin": "opencode-agent",
      "autonomyLevel": "L3",
      "timeoutMinutes": 30,
      "agentConfig": {
        "image": "mediforce-agent:protocol-to-tfl",
        "model": "deepseek/deepseek-chat",
        "repo": "Appsilon/mediforce-clinical-workspace",
        "commit": "4beb1b0ad77872b04bc7ef930def16e555946222",
        "prompt": "Use the `adam-to-tlg` skill: it holds this step's instructions. Load it first and follow it."
      }
    }
  ]
}
