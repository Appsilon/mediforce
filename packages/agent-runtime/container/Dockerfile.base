# =============================================================================
# Mediforce Golden Image
#
# Standard runtime environment for Mediforce AI agents.
# Provides: R + tidyverse, Python 3, Node.js, Claude Code CLI, OpenCode CLI, git, SSH
# Usage:    docker build -f Dockerfile.base -t mediforce-golden-image .
# =============================================================================

FROM rocker/tidyverse:4

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    openssh-client \
    python3 \
    python3-pip \
    python3-requests \
    python-is-python3 \
    curl \
    jq \
    ca-certificates \
    gnupg \
    poppler-utils \
  && rm -rf /var/lib/apt/lists/*

# Install Node.js (LTS) via NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*

# Install Claude Code CLI, pinned: an unpinned install reuses whatever version
# the cached layer first got. 2.1.292 is verified to hold the agent's first turn
# until stdio MCP servers connect (up to MCP_TIMEOUT); 2.1.183 started without them.
# renovate: datasource=npm depName=@anthropic-ai/claude-code
ARG CLAUDE_CODE_VERSION=2.1.292
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

# Install OpenCode CLI, pinned for the same reason. The plugin reads which MCP
# servers failed from OpenCode's log, whose format changed between 1.15 and 1.17.
# renovate: datasource=npm depName=opencode-ai
ARG OPENCODE_VERSION=1.17.8
RUN curl -fsSL https://opencode.ai/install | bash -s -- --version ${OPENCODE_VERSION} \
  && ln -s /root/.opencode/bin/opencode /usr/local/bin/opencode

# Create standard directories
RUN mkdir -p /workspace /output /data /plugin

WORKDIR /workspace
